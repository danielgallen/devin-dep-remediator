# --- Devin ---
# Service-user token from Devin: Organization Settings > Service Users, format cog_*
# This is the v3 Organization API — every session created by this system is
# attributable to that service user in Devin's own audit log.
DEVIN_API_KEY=cog_your_service_user_token_here
DEVIN_API_BASE=https://api.devin.ai/v3
# Optional: normally auto-resolved from GET /v3/self using the token above.
# Set explicitly only if your token has access to multiple orgs.
DEVIN_ORG_ID=

# --- GitHub ---
# Fine-grained PAT (or `gh auth token`) with repo scope on the fork ONLY.
GITHUB_TOKEN=ghp_your_token_here
# The fork this system operates on, e.g. "danielgallen/superset"
GITHUB_REPO=your-org/superset
# Secret configured on the GitHub webhook (Settings > Webhooks), used to verify
# X-Hub-Signature-256 on inbound events. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change_me

# --- App ---
# Label that marks an issue as ready for Devin to pick up
DEVIN_TRIGGER_LABEL=devin-fix
# Label applied while a Devin session is in flight
DEVIN_IN_PROGRESS_LABEL=devin-in-progress
# Label applied when Devin finished and opened a PR
DEVIN_DONE_LABEL=devin-pr-open
# Label applied when a session errors out / expires without a PR
DEVIN_FAILED_LABEL=devin-failed
# Label applied when Devin investigated and determined no safe fix exists yet
# (structured_output.outcome == "blocked") -- a real, valuable verdict, not an error
DEVIN_BLOCKED_LABEL=devin-blocked
# How often (seconds) the background poller checks in-flight Devin sessions
POLL_INTERVAL_SECONDS=30
# How often (seconds) the scheduler re-scans dependencies for new findings (0 disables)
SCAN_INTERVAL_SECONDS=86400
DATABASE_PATH=/data/remediator.db
PORT=8080
